----
import {
  "moonbitlang/async",
  "moonbitlang/async/shell",
  "moonbitlang/async/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}
----

async fn main {
  let args = @env.args()
  let target = if args.length() > 1 { args[1] } else { "wasm-gc" }
  if !["wasm","wasm-gc","js","native"].contains(target) { fail("unsupported verification target") }
  let moon = if args.length() > 2 { args[2] } else { "moon" }
  @shell.Cmd(moon, ["fmt","--check"]).run()
  @shell.Cmd(moon, ["fmt","--check","dev/verify.mbtx","dev/chinook_policy.mbtx","dev/bundle_workflow.mbtx","dev/subset_workflow.mbtx","dev/csv_workflow.mbtx"]).run()
  @shell.Cmd(moon, ["info","--target",target]).run()
  @shell.Cmd("git", ["diff","--exit-code","--","*.mbti"]).run()
  @shell.Cmd(moon, ["check","--frozen","--target",target,"--deny-warn"]).run()
  @shell.Cmd(moon, ["test","--frozen","--target",target,"--deny-warn"]).run()
  if target == "native" || target == "wasm" {
    let prefix = ["run","--frozen","--target",target,"apps/relmask","--"]
    @shell.Cmd(moon, prefix + ["check","examples/tenants/policy.json","examples/tenants/data.json"]).run()
    @shell.Cmd(moon, prefix + ["check","examples/chinook/policy.json","examples/chinook/data.json"]).run()
    let run = @shell.Cmd(moon, prefix + ["mask","examples/chinook/policy.json","examples/chinook/data.json"],
      env={"RELMASK_KEY":"public-example-key-never-use-for-private-data"},
    ).output(max_output_bytes=16_000_000)
    run.check()
    let output = @json.parse(run.stdout(), preserve_number_repr=true)
    let original = @json.parse(@fs.read_file("examples/chinook/data.json").text(), preserve_number_repr=true)
    guard original is Object(original) && output is Object(output) else { fail("expected dataset") }
    if original.length() != output.length() { fail("table loss") }
    let mut total = 0
    for name, original_rows in original {
      guard original_rows is Array(before) && output.get(name) is Some(Array(after)) else { fail("table loss") }
      if before.length() != after.length() { fail("row loss") }
      total += after.length()
      for i, row in before {
        guard row is Object(a) && after[i] is Object(b) else { fail("row shape changed") }
        if a.length() != b.length() { fail("column loss") }
        for column in ["UnitPrice","Total","InvoiceDate","Quantity"] {
          if a.get(column) is Some(value) && b.get(column) is Some(other) {
            if value.stringify() != other.stringify() { fail("untargeted business value changed") }
          }
        }
      }
    }
    // Independently walk the customer -> invoice -> line graph from raw output.
    guard output.get("Customer") is Some(Array(customers)) && output.get("Invoice") is Some(Array(invoices)) && output.get("InvoiceLine") is Some(Array(lines)) else { fail("missing graph") }
    let customer_ids : Map[String, Bool] = Map([])
    for row in customers { guard row is {"CustomerId":id,..} else { fail("missing key") }; customer_ids[id.stringify()] = true }
    let invoice_ids : Map[String, Bool] = Map([])
    for row in invoices {
      guard row is {"InvoiceId":id,"CustomerId":parent,..} else { fail("missing keys") }
      if !customer_ids.contains(parent.stringify()) { fail("dangling customer reference") }
      invoice_ids[id.stringify()] = true
    }
    for row in lines {
      guard row is {"InvoiceId":parent,..} else { fail("missing key") }
      if !invoice_ids.contains(parent.stringify()) { fail("dangling invoice reference") }
    }
    println("Chinook CLI round trip: " + total.to_string() + " rows, graph and business values checked")
    @shell.Cmd(moon, ["run","--frozen","dev/bundle_workflow.mbtx","--",target,moon]).run()
    @shell.Cmd(moon, ["run","--frozen","dev/subset_workflow.mbtx","--",target,moon]).run()
    @shell.Cmd(moon, ["run","--frozen","dev/csv_workflow.mbtx","--",target,moon]).run()
  }
}
